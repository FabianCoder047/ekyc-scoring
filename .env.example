# ---------------------------------------------------------------------------
# Ports exposés sur l'hôte
# ---------------------------------------------------------------------------
FRONTEND_PORT=8081
BACKEND_PORT=8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Mot de passe du superutilisateur PostgreSQL (uniquement pour l'initialisation).
POSTGRES_PASSWORD=changez-moi-postgres

# Rôle utilisé par Flyway (propriétaire de la base et des objets).
DB_MIGRATION_USER=kyc
DB_MIGRATION_PASSWORD=changez-moi-migration

# Rôle applicatif à privilèges limités (aucune modification de l'audit).
DB_APP_USER=kyc_app
DB_APP_PASSWORD=changez-moi-app

# ---------------------------------------------------------------------------
# Secrets applicatifs — à générer, ne jamais versionner le fichier .env
# ---------------------------------------------------------------------------
# JWT_SECRET : au moins 32 octets encodés en base64.
#   openssl rand -base64 48
JWT_SECRET=

# KYC_ENCRYPTION_KEY : exactement 32 octets encodés en base64 (AES-256-GCM).
#   openssl rand -base64 32
KYC_ENCRYPTION_KEY=

# Origines autorisées pour le développement direct du frontend (CORS).
# En Docker, le frontend et l'API partagent la même origine via nginx.
CORS_ORIGINS=http://localhost:8081,http://localhost:4200
